{
	"devDependencies": {
		"@types/reach__router": "^1.3.9",
		"@types/react": "^17.0.34",
		"@types/styled-components": "^5.1.15",
		"pre-commit": "^1.2.2"
	},
	"dependencies": {
		"framer-motion": "^5.2.1",
		"gatsby": "^4.1.0",
		"gatsby-plugin-manifest": "^4.1.0",
		"polished": "^4.1.3",
		"react": "^17.0.2",
		"react-dom": "^17.0.2",
		"react-map-interaction": "^2.1.0",
		"react-tooltip": "^4.2.21",
		"styled-components": "^5.3.3",
		"typescript": "^4.4.4"
	},
	"name": "saunce",
	"version": "0.0.1",
	"main": "index.js",
	"repository": "https://github.com/inferrinizzard/saunce.git",
	"author": "inferrinizzard <inferrinizzard@gmail.com>",
	"license": "MIT",
	"config": {
		"port": "8080"
	},
	"scripts": {
		"build": "gatsby build",
		"serve": "gatsby serve",
		"start": "start http://localhost:8080 && gatsby develop -p 8080",
		"fmt": "prettier --write \"src/**/*.{js, jsx, ts, tsx, json, css, html}\""
	},
	"pre-commit": [
		"fmt"
	],
	"prettier": {
		"printWidth": 100,
		"jsxBracketSameLine": true,
		"trailingComma": "es5",
		"useTabs": true,
		"arrowParens": "avoid",
		"singleQuote": true,
		"semi": true,
		"quoteProps": "consistent"
	}
}
